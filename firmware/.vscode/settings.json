{
    // Firmware-specific settings (STM32 embedded development)
    // These settings only apply when working in the firmware directory
    
    "cmake.preferredGenerators": [
        "Ninja"
    ],
    "cmake.configureOnOpen": false,
    "cmake.configureOnEdit": false,
    "cmake.statusbar.advanced": {
        "build": {
            "visibility": "icon"
        },
        "launch": {
            "visibility": "hidden"
        }
    },
    
    // File associations specific to embedded development
    "files.associations": {
        "*.ld": "linkerscript",
        "*.svd": "xml",
        "*.ioc": "xml"
    },
    
    // Code formatting with clangd
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    
    // Disable C_Cpp extension in favor of clangd
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--header-insertion=never",
        "--compile-commands-dir=${workspaceFolder}/build/arm-gcc-debug"
    ]
}