{
    // Monorepo root settings - applies to all subprojects
    // Firmware-specific settings are in firmware/.vscode/settings.json
    
    // CMake configuration - points to firmware subfolder
    "cmake.sourceDirectory": "${workspaceFolder}/firmware",
    
    // File associations for multiple project types
    "files.associations": {
        "*.pde": "java"  // Processing sketches
    },
    
    // Performance: exclude build artifacts and dependencies
    "files.watcherExclude": {
        "**/build/**": true,
        "**/node_modules/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true
    },
    "search.exclude": {
        "**/build/**": true,
        "**/third_party/**": true,
        "**/node_modules/**": true,
        "**/.git/**": true
    },
    
    // Terminal: MSYS2 UCRT64 (required for build toolchain)
    "terminal.integrated.profiles.windows": {
        "MSYS2 UCRT64": {
            "path": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": [
                "--login",
                "-i"
            ],
            "env": {
                "MSYSTEM": "UCRT64",
                "CHERE_INVOKING": "1"
            }
        }
    },
    "terminal.integrated.defaultProfile.windows": "MSYS2 UCRT64"
}